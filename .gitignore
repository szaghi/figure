# build products (native layer: build/native; FoBiS: exe mod obj lib; fpm: build/gfortran_* etc.)
/build/
/exe/
/mod/
/obj/
/mod-traps/
/obj-traps/
/lib/
/include/
/share/
/build_native.log
# the Fortran libraries fetched by `fobis fetch` (fobos [dependencies]): sources, lock file and deps config
/src/third_party/
imgui.ini
__pycache__/
# VitePress (docs/examples/build.sh writes into build/docs-examples, ignored above)
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# coverage outputs (fobis rule --ex makecoverage-analysis), published by the CI, never committed
*.gcov
docs/guide/coverage-analysis.md
docs/guide/*.gcov.md
docs/public/coverage.json
# test_compare_image and docs_media.py --check: a picture that failed and its diff (accepted by --update, or removed)
*.new.png
*.diff.png
*.atlas[0-9]*.png

# the API pages, generated by formal from the doc comments (npm run docs:api, run first by docs:dev and docs:build)
docs/api/
