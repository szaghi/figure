# build products (native layer: build/native; FoBiS: exe mod obj lib; fpm: build/gfortran_* etc.)
/build/
/exe/
/mod/
/obj/
/lib/
/include/
/build_native.log
imgui.ini
__pycache__/
# VitePress (docs/examples/build.sh writes into build/docs-examples, ignored above)
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# coverage outputs (fobis rule --ex makecoverage-analysis), published by the CI, never committed
*.gcov
docs/guide/coverage-analysis.md
docs/guide/*.gcov.md
docs/public/coverage.json
