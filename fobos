[project]
name       = figure
version    = VERSION
summary    = FIGURE, Fortran Immediate-mode GUI for User interfaces, Rendering and Exploration
repository = https://github.com/szaghi/figure
authors    = Stefano Zaghi
email      = stefano.zaghi@cnr.it

# The owner's Fortran libraries (szaghi/figure#15 §6), source-passed: `fobis fetch` clones each one's default branch into
# src/third_party/ (git-ignored) and FIGURE's modes compile its src/lib with FIGURE's own flags; the libraries' own fobos
# and fpm.toml are never read. The list is closed (§6's rule): every library a listed one uses is listed here too, and in
# fpm.toml [dependencies] (scripts/check_sync.py checks both). PENF is built without PENF_R16P (no quadruple precision).
# FUNDAL's fundal_mpih_object.F90 (the MPI handler, `use mpi`) is excluded by the templates: FIGURE has no MPI.
# foresight (§6, K4) joins once it builds with nvfortran 26.9 and ifx under FIGURE's flags (P3's log).
[dependencies]
deps_dir   = src/third_party
PENF       = https://github.com/szaghi/PENF :: branch=master :: src=src/lib
FACE       = https://github.com/szaghi/FACE :: branch=master :: src=src/lib
BeFoR64    = https://github.com/szaghi/BeFoR64 :: branch=master :: src=src/lib
StringiFor = https://github.com/szaghi/StringiFor :: branch=master :: src=src/lib
FUNDAL     = https://github.com/szaghi/FUNDAL :: branch=main :: src=src/lib

[modes]
modes = tests-gnu tests-gnu-debug examples-gnu examples-gnu-traps
        tests-nvf examples-nvf
        tests-ifx examples-ifx
        figure-static-gnu figure-static-nvf figure-static-ifx
        tests-gnu-fortran examples-gnu-fortran tests-nvf-fortran examples-nvf-fortran tests-ifx-fortran examples-ifx-fortran

# The native layer (libfigure_native.a + libSDL3.a in lib/) is built by `fobis rule --ex native` (CMake), run
# automatically before every build (pre_build): a no-op once built. Linking it needs platform libraries: one varset per
# platform (`--varset macos`, `--varset windows`; linux by default). Each must cover the static link line SDL reports
# for that platform (lib/pkgconfig/sdl3.pc), plus the C++ runtime: scripts/check_sync.py checks the varset of the
# platform it runs on. fpm.toml [build] link holds only figure_native and SDL3 (scripts/fpm.sh adds the rest).
[varsets]
default = linux

[varset:linux]
$NATIVE_LIBS   = figure_native SDL3 stdc++ dl pthread m
$NATIVE_LFLAGS =

[varset:macos]
$NATIVE_LIBS   = figure_native SDL3 figure_clang_rt c++ objc iconv pthread m
$NATIVE_LFLAGS = -framework Cocoa -framework Carbon -framework Foundation -framework CoreVideo -framework CoreMedia
                 -framework IOKit -framework Metal -framework QuartzCore -framework UniformTypeIdentifiers
                 -framework AVFoundation

[varset:windows]
$NATIVE_LIBS   = figure_native SDL3 stdc++ pthread m ws2_32 kernel32 user32 gdi32 winmm imm32 ole32 oleaut32 version uuid
                 advapi32 setupapi shell32
$NATIVE_LFLAGS =

[common-variables]
$CGNU        = -c -std=f2018 -ffree-line-length-132 -fimplicit-none
$CGNU_DEBUG  = -Og -g3 -fcheck=all -fbacktrace -Wall -Wimplicit-interface -Wimplicit-procedure -finit-real=nan -ffpe-trap=invalid,zero,overflow
$CNVF        = -c -Mstandard -Mfree -Munixlogical
$CIFX        = -c -stand f18 -free -fpscomp logicals
$EXCLUDE     = src/third_party/FUNDAL/src/lib/fundal_mpih_object.F90

# main modes: the tests build into exe/ (scripts/run_tests.sh runs every program there), the examples into exe/examples/
# (with their own mod/ and obj/), which run_tests.sh does not enter
[tests-gnu]
template  = template-gnu
cflags    = $CGNU -O2
build_dir = exe
src       = src/lib/ src/tests/

[tests-gnu-debug]
template  = template-gnu
cflags    = $CGNU $CGNU_DEBUG
build_dir = exe
src       = src/lib/ src/tests/

[examples-gnu]
template  = template-gnu
cflags    = $CGNU -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

# examples-gnu-traps: the examples with gfortran's floating-point traps, run in a window by the Platforms workflow
# (window_check.py, its Windows job: Mesa's llvmpipe): the native layer holds the FP environment around the GL driver,
# so a program built with traps opens its window (Mesa raised them at window creation before)
[examples-gnu-traps]
template  = template-gnu
cflags    = $CGNU -O2 -ffpe-trap=invalid,zero,overflow
openmp    = True
build_dir = exe/examples-traps
obj_dir   = obj-traps
mod_dir   = mod-traps
src       = src/lib/ src/examples/

# nvfortran: -Munixlogical ($CNVF) makes .true. the C value 1 (the default is -1, not a C bool), as ifx's -fpscomp logicals;
# it is also a link flag (template-nvf's lflags): it selects the run-time library's logical values, and code compiled
# with it but linked without it (or the reverse) gets `select type` wrong
# tests-nvf: -mp (openmp) also makes nvfortran's I/O runtime thread-safe, which the tasks' test needs
[tests-nvf]
template  = template-nvf
cflags    = $CNVF -O2
openmp    = True
build_dir = exe
src       = src/lib/ src/tests/

[examples-nvf]
template  = template-nvf
cflags    = $CNVF -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

# ifx (Intel oneAPI): -fpscomp logicals makes .true. the C value 1 (the default is -1, which is not a C bool); its
# I/O runtime is thread-safe with no flag (ifx links libifcoremt by default), so tests-ifx needs no openmp
[tests-ifx]
template  = template-ifx
cflags    = $CIFX -O2
build_dir = exe
src       = src/lib/ src/tests/

[examples-ifx]
template  = template-ifx
cflags    = $CIFX -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

[figure-static-gnu]
template  = template-gnu
cflags    = $CGNU -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

[figure-static-nvf]
template  = template-nvf
cflags    = $CNVF -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

[figure-static-ifx]
template  = template-ifx
cflags    = $CIFX -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

# the Fortran path (szaghi/figure#15 §2): each seam's Fortran implementation in a sibling directory of the current one,
# under the same module names (src/lib/core_fortran/ beside src/lib/core_imgui/, ...), picked by a mode's `src`, with no
# preprocessor macro. A -fortran mode builds the newest path: the layers already ported, the others from the current path.
# No layer is ported yet: each mode takes its default mode as its template (every key, `src` included), so it builds
# exactly what the default builds; a ported layer overrides `src` here. They build into the default's directories:
# switching path, as switching compiler, needs `--force-compile` (or `rm -rf exe`)
[tests-gnu-fortran]
template  = tests-gnu

[examples-gnu-fortran]
template  = examples-gnu

[tests-nvf-fortran]
template  = tests-nvf

[examples-nvf-fortran]
template  = examples-nvf

[tests-ifx-fortran]
template  = tests-ifx

[examples-ifx-fortran]
template  = examples-ifx

# templates
[template-gnu]
compiler  = gnu
exclude   = $EXCLUDE
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS
pre_build = native
colors    = True
quiet     = False
jobs      = 4

[template-nvf]
compiler  = nvfortran
exclude   = $EXCLUDE
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS -Munixlogical
pre_build = native
colors    = True
quiet     = False
jobs      = 4

[template-ifx]
compiler  = intel_nextgen
exclude   = $EXCLUDE
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS
pre_build = native
colors    = True
quiet     = False
jobs      = 4

# rules
[rule-native]
help = Build the native layer (ImGui, ImPlot, cimgui, cimplot, SDL3, glue) into lib/ with CMake
rule = bash scripts/build_native.sh

[rule-bindings]
help = Regenerate the raw cimgui/cimplot layer (Fortran interfaces, C++ glue, layout test, docs page) from the metadata
rule = python3 scripts/gen_bindings.py

[rule-bindings-check]
help = Check that the committed generated bindings match the cimgui/cimplot metadata
rule = python3 scripts/gen_bindings.py --check

[rule-sync]
help = Check that fobos and fpm.toml describe the same build
rule = python3 scripts/check_sync.py

[rule-delexe]
help = Delete exes and libs (the native layer in lib/ included: the next build rebuilds it)
rule = rm -rf exe/ lib/

[rule-clean]
help   = Clean the project tree
rule_1 = fobis rule --ex delexe
rule_2 = rm -rf mod/ obj/
rule_3 = rm -f *.gcov

# rule_4: the coverage is FIGURE's: the run data of the Fortran libraries (src/third_party, compiled for
# figure_test_sibling_libs) is removed before compute-coverage.sh and the gcov pages read it
[rule-makecoverage]
help   = Perform coverage analysis (and check the generated bindings against the cimgui/cimplot metadata)
rule_1 = fobis build --mode tests-gnu-debug --coverage --force-compile
rule_2 = python3 scripts/gen_bindings.py --check --check-symbols lib/libfigure_native.a
rule_3 = bash scripts/run_tests.sh
rule_4 = bash -c 'for f in src/third_party/*/src/lib/*.[Ff]90; do b="${f##*/}"; rm -f "exe/obj/${b%.*}.gcda"; done'
rule_5 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Perform coverage analysis and saving reports in markdown
rule_1 = fobis rule --ex makecoverage
rule_2 = fobis rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = bash -c 'rm -f *.gcov parsed.xml source.xml'

[rule-docs-examples]
help = Build and run the documentation examples, regenerating their snippets and outputs
rule = bash docs/examples/build.sh

# fobis scaffold: the CI installs these system packages (SDL3 needs the X11/Wayland/EGL/DBus headers to configure
# a windowed build; the headless test itself needs no display). LICENSE.gpl3.md is skipped: FIGURE is MIT only (LICENSE.mit.md).
# install.yml is FIGURE's own: its fpm step builds the package published as the tag vX.Y.Z-fpm (fpm.yml), since the
# repository's fpm.toml needs the native layer built first. scripts/install.sh is FIGURE's own one-line installer
# (per compiler, the native layer, pkg-config, uninstall; tested by installer.yml), published as a release asset.
# ci.yml's test and docs.yml's build run in the fortran-toolchains image (gfortran 16.2, the compiler of the local
# builds); toolchain_packages adds what that image lacks: ninja and SDL3's headers. apt_packages stays for the jobs
# on the bare runner (install.yml).
[scaffold]
apt_packages       = cmake ninja-build libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev
                     libxtst-dev libwayland-dev libxkbcommon-dev libegl-dev libdbus-1-dev libdecor-0-dev
toolchain          = linux-gnu
toolchain_packages = ninja-build libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev
                     libxtst-dev libwayland-dev libxkbcommon-dev libegl-dev libdbus-1-dev libdecor-0-dev
skip               = LICENSE.gpl3.md .github/workflows/install.yml scripts/install.sh .github/workflows/fpm.yml
                     .github/actions/setup-build-env/action.yml
