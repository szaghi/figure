[project]
name       = figure
version    = VERSION
summary    = FIGURE, Fortran Immediate-mode GUI for User interfaces, Rendering and Exploration
repository = https://github.com/szaghi/figure
authors    = Stefano Zaghi
email      = stefano.zaghi@cnr.it

[modes]
modes = tests-gnu tests-gnu-debug examples-gnu
        tests-nvf examples-nvf
        tests-ifx examples-ifx
        figure-static-gnu figure-static-nvf figure-static-ifx

# The native layer (libfigure_native.a + libSDL3.a in lib/) is built by `fobis rule --ex native` (CMake), run
# automatically before every build (pre_build): a no-op once built. Linking it needs platform libraries: one varset per
# platform (`--varset macos`, `--varset windows`; linux by default). Each must cover the static link line SDL reports
# for that platform (lib/pkgconfig/sdl3.pc), plus the C++ runtime: scripts/check_sync.py checks the varset of the
# platform it runs on. fpm.toml [build] link holds only figure_native and SDL3 (scripts/fpm.sh adds the rest).
[varsets]
default = linux

[varset:linux]
$NATIVE_LIBS   = figure_native SDL3 stdc++ dl pthread m
$NATIVE_LFLAGS =

[varset:macos]
$NATIVE_LIBS   = figure_native SDL3 figure_clang_rt c++ objc iconv pthread m
$NATIVE_LFLAGS = -framework Cocoa -framework Carbon -framework Foundation -framework CoreVideo -framework CoreMedia
                 -framework IOKit -framework Metal -framework QuartzCore -framework UniformTypeIdentifiers
                 -framework AVFoundation

[varset:windows]
$NATIVE_LIBS   = figure_native SDL3 stdc++ pthread m ws2_32 kernel32 user32 gdi32 winmm imm32 ole32 oleaut32 version uuid
                 advapi32 setupapi shell32
$NATIVE_LFLAGS =

[common-variables]
$CGNU        = -c -std=f2018 -ffree-line-length-132 -fimplicit-none
$CGNU_DEBUG  = -Og -g3 -fcheck=all -fbacktrace -Wall -Wimplicit-interface -Wimplicit-procedure -finit-real=nan -ffpe-trap=invalid,zero,overflow
$CNVF        = -c -Mstandard -Mfree -Munixlogical
$CIFX        = -c -stand f18 -free -fpscomp logicals

# main modes: the tests build into exe/ (scripts/run_tests.sh runs every program there), the examples into exe/examples/
# (with their own mod/ and obj/), which run_tests.sh does not enter
[tests-gnu]
template  = template-gnu
cflags    = $CGNU -O2
build_dir = exe
src       = src/lib/ src/tests/

[tests-gnu-debug]
template  = template-gnu
cflags    = $CGNU $CGNU_DEBUG
build_dir = exe
src       = src/lib/ src/tests/

[examples-gnu]
template  = template-gnu
cflags    = $CGNU -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

# nvfortran: -Munixlogical ($CNVF) makes .true. the C value 1 (the default is -1, not a C bool), as ifx's -fpscomp logicals;
# it is also a link flag (template-nvf's lflags): it selects the run-time library's logical values, and code compiled
# with it but linked without it (or the reverse) gets `select type` wrong
# tests-nvf: -mp (openmp) also makes nvfortran's I/O runtime thread-safe, which the tasks' test needs
[tests-nvf]
template  = template-nvf
cflags    = $CNVF -O2
openmp    = True
build_dir = exe
src       = src/lib/ src/tests/

[examples-nvf]
template  = template-nvf
cflags    = $CNVF -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

# ifx (Intel oneAPI): -fpscomp logicals makes .true. the C value 1 (the default is -1, which is not a C bool); its
# I/O runtime is thread-safe with no flag (ifx links libifcoremt by default), so tests-ifx needs no openmp
[tests-ifx]
template  = template-ifx
cflags    = $CIFX -O2
build_dir = exe
src       = src/lib/ src/tests/

[examples-ifx]
template  = template-ifx
cflags    = $CIFX -O2
openmp    = True
build_dir = exe/examples
src       = src/lib/ src/examples/

[figure-static-gnu]
template  = template-gnu
cflags    = $CGNU -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

[figure-static-nvf]
template  = template-nvf
cflags    = $CNVF -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

[figure-static-ifx]
template  = template-ifx
cflags    = $CIFX -O2
build_dir = lib
src       = src/lib/
target    = src/lib/figure_library.F90
output    = libfigure.a
mklib     = static

# templates
[template-gnu]
compiler  = gnu
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS
pre_build = native
colors    = True
quiet     = False
jobs      = 4

[template-nvf]
compiler  = nvfortran
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS -Munixlogical
pre_build = native
colors    = True
quiet     = False
jobs      = 4

[template-ifx]
compiler  = intel_nextgen
mod_dir   = mod
obj_dir   = obj
lib_dir   = lib
ext_libs  = $NATIVE_LIBS
lflags    = $NATIVE_LFLAGS
pre_build = native
colors    = True
quiet     = False
jobs      = 4

# rules
[rule-native]
help = Build the native layer (ImGui, ImPlot, cimgui, cimplot, SDL3, glue) into lib/ with CMake
rule = bash scripts/build_native.sh

[rule-bindings]
help = Regenerate the raw cimgui/cimplot layer (Fortran interfaces, C++ glue, layout test, docs page) from the metadata
rule = python3 scripts/gen_bindings.py

[rule-bindings-check]
help = Check that the committed generated bindings match the cimgui/cimplot metadata
rule = python3 scripts/gen_bindings.py --check

[rule-sync]
help = Check that fobos and fpm.toml describe the same build
rule = python3 scripts/check_sync.py

[rule-delexe]
help = Delete exes and libs (the native layer in lib/ included: the next build rebuilds it)
rule = rm -rf exe/ lib/

[rule-clean]
help   = Clean the project tree
rule_1 = fobis rule --ex delexe
rule_2 = rm -rf mod/ obj/
rule_3 = rm -f *.gcov

[rule-makecoverage]
help   = Perform coverage analysis (and check the generated bindings against the cimgui/cimplot metadata)
rule_1 = fobis build --mode tests-gnu-debug --coverage --force-compile
rule_2 = python3 scripts/gen_bindings.py --check --check-symbols lib/libfigure_native.a
rule_3 = bash scripts/run_tests.sh
rule_4 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Perform coverage analysis and saving reports in markdown
rule_1 = fobis rule --ex makecoverage
rule_2 = fobis rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = bash -c 'rm -f *.gcov parsed.xml source.xml'

[rule-docs-examples]
help = Build and run the documentation examples, regenerating their snippets and outputs
rule = bash docs/examples/build.sh

# fobis scaffold: the CI installs these system packages (SDL3 needs the X11/Wayland/EGL/DBus headers to configure
# a windowed build; the headless test itself needs no display). LICENSE.gpl3.md is skipped: FIGURE is MIT only (LICENSE.mit.md).
# install.yml is FIGURE's own: its fpm step builds the package published as the tag vX.Y.Z-fpm (fpm.yml), since the
# repository's fpm.toml needs the native layer built first.
[scaffold]
apt_packages = cmake ninja-build libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev
               libxtst-dev libwayland-dev libxkbcommon-dev libegl-dev libdbus-1-dev libdecor-0-dev
skip         = LICENSE.gpl3.md .github/workflows/install.yml
