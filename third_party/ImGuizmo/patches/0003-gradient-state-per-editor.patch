+      int movingPt = storage->GetInt(movingId, -1);
+      ImGui::BeginChild(childId, size, ImGuiChildFlags_FrameStyle);
 
       ImDrawList* draw_list = ImGui::GetWindowDrawList();
       const ImVec2 offset = ImGui::GetCursorScreenPos();
+      // an item under the points takes the press, which would otherwise move the window (FIGURE's patch 0003)
+      ImGui::InvisibleButton("##points", ImMax(ImGui::GetContentRegionAvail(), ImVec2(1.f, 1.f)));
 
       const ImVec4* pts = delegate.GetPoints();
